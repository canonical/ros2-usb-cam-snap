#!/bin/bash
# snap/hooks/install
#
# Runs once, at first install only (snapd does NOT re-run this on refresh).
# Seeds a managed default ROS params YAML file under $SNAP_COMMON so the
# camera has sane defaults to edit/patch from day one, without ever
# clobbering an admin's hand edits on subsequent refreshes (see the
# defensive re-check in snap/hooks/configure, which covers upgrades from
# older versions of this snap that predate this hook).
set -e

mkdir -p "$SNAP_COMMON/config"

if [ ! -f "$SNAP_COMMON/config/usb_cam.yaml" ]; then
  cp "$SNAP/usr/share/usb-cam/default-params.yaml" "$SNAP_COMMON/config/usb_cam.yaml"
fi
